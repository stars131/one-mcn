generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String?
  name               String?
  aiCredits          Int                 @default(1000)
  activatedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           AuthSession[]
  operatingAccounts  OperatingAccount[]
  modelPreference    UserModelPreference?
  modelConfigs       UserModelConfig[]
  ipProfiles         IpProfile[]
  personaConversations PersonaConversation[]
  personaMessages    PersonaMessage[]
  sources            Source[]
  hotTopics          HotTopic[]
  topics             Topic[]
  contents           Content[]
  publishRecords     PublishRecord[]
  contentMetrics     ContentMetric[]
  analyticsSnapshots AnalyticsSnapshot[]
  reviewReports      ReviewReport[]
}

model UserModelPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  mode            String   @default("server_credits")
  selectedConfigId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedConfig  UserModelConfig? @relation(fields: [selectedConfigId], references: [id], onDelete: SetNull)
}

model UserModelConfig {
  id              String   @id @default(cuid())
  userId          String
  name            String
  textProvider    String   @default("newapi")
  textBaseUrl     String
  textModel       String
  textApiKey      String?
  multimodalProvider String @default("newapi")
  multimodalBaseUrl String
  multimodalModel String
  multimodalApiKey String?
  imageProvider   String   @default("newapi")
  imageBaseUrl    String
  imageModel      String
  imageApiKey     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences     UserModelPreference[]

  @@index([userId])
}

model AppSetting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model OperatingAccount {
  id                 String              @id @default(cuid())
  userId             String
  name               String
  platform           String?
  handle             String?
  description        String?
  avatarUrl          String?
  status             String              @default("active")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipProfiles         IpProfile[]
  personaConversations PersonaConversation[]
  personaMessages    PersonaMessage[]
  sources            Source[]
  hotTopics          HotTopic[]
  topics             Topic[]
  contents           Content[]
  publishRecords     PublishRecord[]
  contentMetrics     ContentMetric[]
  analyticsSnapshots AnalyticsSnapshot[]
  reviewReports      ReviewReport[]

  @@index([userId])
}

model InviteCode {
  id          String    @id @default(cuid())
  codeHash    String    @unique
  label       String?
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IpProfile {
  id                String     @id @default(cuid())
  userId            String
  operatingAccountId String?
  name              String
  niche             String
  targetAudience    String
  userPainPoints    Json       @default("[]")
  valueProposition  String
  toneStyle         String
  platforms         Json       @default("[]")
  monetizationGoals Json       @default("[]")
  keywords          Json       @default("[]")
  competitors       Json       @default("[]")
  blockedTopics     Json       @default("[]")
  notes             Json       @default("[]")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingAccount  OperatingAccount? @relation(fields: [operatingAccountId], references: [id], onDelete: SetNull)
  hotTopics         HotTopic[]
  topics            Topic[]
  personaConversations PersonaConversation[]

  @@index([userId, operatingAccountId])
}

model PersonaConversation {
  id                 String     @id @default(cuid())
  userId             String
  operatingAccountId String?
  ipProfileId        String?
  title              String
  status             String     @default("active")
  currentPrompt      String?
  lastUserAnswer     String?
  lastAssistantReply String?
  options            Json       @default("[]")
  completion         Json       @default("{}")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingAccount   OperatingAccount? @relation(fields: [operatingAccountId], references: [id], onDelete: SetNull)
  ipProfile          IpProfile? @relation(fields: [ipProfileId], references: [id], onDelete: SetNull)
  messages           PersonaMessage[]

  @@index([userId, operatingAccountId])
  @@index([ipProfileId])
}

model PersonaMessage {
  id                 String     @id @default(cuid())
  userId             String
  operatingAccountId String?
  conversationId     String
  role               String
  content            String
  patch              Json       @default("{}")
  options            Json       @default("[]")
  createdAt          DateTime   @default(now())
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingAccount   OperatingAccount? @relation(fields: [operatingAccountId], references: [id], onDelete: SetNull)
  conversation       PersonaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, operatingAccountId])
  @@index([conversationId, createdAt])
}

model Source {
  id        String       @id @default(cuid())
  userId    String
  operatingAccountId String?
  name      String
  type      SourceType
  url       String?
  enabled   Boolean      @default(true)
  config    Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingAccount OperatingAccount? @relation(fields: [operatingAccountId], references: [id], onDelete: SetNull)
  items     SourceItem[]
  hotTopics HotTopic[]
  fetchJobs FetchJob[]

  @@index([userId, operatingAccountId])
}

model SourceItem {
  id          String    @id @default(cuid())
  sourceId    String
  externalId  String?
  title       String
  summary     String?
  url         String?
  author      String?
  publishedAt DateTime?
  rawMetrics  Json      @default("{}")
  rawData     Json      @default("{}")
  createdAt   DateTime  @default(now())
  source      Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model FetchJob {
  id           String     @id @default(cuid())
  sourceId     String
  sourceName   String
  status       JobStatus
  startedAt    DateTime
  finishedAt   DateTime?
  itemCount    Int        @default(0)
  errorMessage String?
  params       Json       @default("{}")
  createdAt    DateTime   @default(now())
  source       Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model HotTopic {
  id                  String     @id @default(cuid())
  userId              String
  operatingAccountId  String?
  ipProfileId         String?
  sourceId            String?
  title               String
  summary             String?
  url                 String?
  platform            String?
  sourceName          String
  sourceType          SourceType
  keyword             String?
  tags                Json       @default("[]")
  heatScore           Float      @default(0)
  matchScore          Float      @default(0)
  businessScore       Float      @default(0)
  competitionScore    Float      @default(0)
  freshnessScore      Float      @default(0)
  recommendationScore Float      @default(0)
  recommendedAngles   Json       @default("[]")
  suitablePlatforms   Json       @default("[]")
  contentFormats      Json       @default("[]")
  status              TopicStatus @default(new)
  rawMetrics          Json       @default("{}")
  rawData             Json       @default("{}")
  collectedAt         DateTime   @default(now())
  analyzedAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingAccount    OperatingAccount? @relation(fields: [operatingAccountId], references: [id], onDelete: SetNull)
  ipProfile           IpProfile? @relation(fields: [ipProfileId], references: [id], onDelete: SetNull)
  source              Source?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  topics              Topic[]

  @@index([userId, operatingAccountId])
}

model Topic {
  id              String       @id @default(cuid())
  userId          String
  operatingAccountId String?
  ipProfileId     String?
  hotTopicId      String?
  title           String
  corePoint       String
  targetAudience  String
  userPainPoint   String
  platform        String
  contentType     String
  status          ContentStatus @default(draft)
  trafficScore    Float        @default(0)
  businessScore   Float        @default(0)
  difficultyScore Float        @default(0)
  reason          String?
  outline         Json         @default("[]")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingAccount OperatingAccount? @relation(fields: [operatingAccountId], references: [id], onDelete: SetNull)
  ipProfile       IpProfile?   @relation(fields: [ipProfileId], references: [id], onDelete: SetNull)
  hotTopic        HotTopic?    @relation(fields: [hotTopicId], references: [id], onDelete: SetNull)
  contents        Content[]

  @@index([userId, operatingAccountId])
}

model Content {
  id           String          @id @default(cuid())
  userId       String
  operatingAccountId String?
  topicId      String?
  platform     String
  contentType  String
  title        String
  titles       Json            @default("[]")
  coverTexts   Json            @default("[]")
  hook         String?
  body         String
  cta          String?
  tags         Json            @default("[]")
  commentGuide String?
  status       PublishStatus   @default(draft)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingAccount OperatingAccount? @relation(fields: [operatingAccountId], references: [id], onDelete: SetNull)
  topic        Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  publishRecords PublishRecord[]
  metrics      ContentMetric[]

  @@index([userId, operatingAccountId])
}

model PublishRecord {
  id           String       @id @default(cuid())
  userId       String
  operatingAccountId String?
  contentId    String
  platform     String
  plannedAt    DateTime?
  publishedAt  DateTime?
  publishedUrl String?
  status       PublishStatus @default(planned)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingAccount OperatingAccount? @relation(fields: [operatingAccountId], references: [id], onDelete: SetNull)
  content      Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([userId, operatingAccountId])
}

model ContentMetric {
  id              String   @id @default(cuid())
  userId          String
  operatingAccountId String?
  contentId       String
  platform        String
  views           Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  saves           Int      @default(0)
  shares          Int      @default(0)
  followersGained Int      @default(0)
  completionRate  Float    @default(0)
  clickRate       Float    @default(0)
  avgWatchTime    Float    @default(0)
  impressions     Int      @default(0)
  collectedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingAccount OperatingAccount? @relation(fields: [operatingAccountId], references: [id], onDelete: SetNull)
  content         Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([userId, operatingAccountId])
}

model AnalyticsSnapshot {
  id                    String   @id @default(cuid())
  userId                String
  operatingAccountId    String?
  periodStart           DateTime
  periodEnd             DateTime
  totalContents         Int      @default(0)
  totalViews            Int      @default(0)
  totalLikes            Int      @default(0)
  totalComments         Int      @default(0)
  totalSaves            Int      @default(0)
  totalShares           Int      @default(0)
  totalFollowersGained  Int      @default(0)
  avgLikeRate           Float    @default(0)
  avgCommentRate        Float    @default(0)
  avgSaveRate           Float    @default(0)
  avgShareRate          Float    @default(0)
  avgFollowerGainRate   Float    @default(0)
  topPlatform           String?
  topContentType        String?
  topTopicTags          Json     @default("[]")
  summaryData           Json     @default("{}")
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingAccount      OperatingAccount? @relation(fields: [operatingAccountId], references: [id], onDelete: SetNull)

  @@index([userId, operatingAccountId])
}

model ReviewReport {
  id                 String   @id @default(cuid())
  userId             String
  operatingAccountId String?
  periodStart        DateTime
  periodEnd          DateTime
  summary            String
  keyFindings        Json     @default("[]")
  winningPatterns    Json     @default("[]")
  losingPatterns     Json     @default("[]")
  recommendedActions Json     @default("[]")
  nextTopics         Json     @default("[]")
  rawData            Json     @default("{}")
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingAccount   OperatingAccount? @relation(fields: [operatingAccountId], references: [id], onDelete: SetNull)

  @@index([userId, operatingAccountId])
}

enum SourceType {
  hot_feed
  github
  rss
  api_json
  manual
  webpage
}

enum JobStatus {
  running
  success
  failed
}

enum TopicStatus {
  new
  analyzed
  used
  ignored
}

enum ContentStatus {
  draft
  approved
  generating
  archived
}

enum PublishStatus {
  draft
  planned
  published
  failed
}
